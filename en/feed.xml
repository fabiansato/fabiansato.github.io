layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom"><title>Fabian Sato — EN</title><link href="{{ '/en/feed.xml' | absolute_url }}" rel="self"/><link href="{{ '/en/' | absolute_url }}"/><id>{{ '/en/' | absolute_url }}</id><updated>{{ site.time | date_to_xmlschema }}</updated><author><name>Fabian Gonzalez</name></author>{% assign posts = site.posts | where: 'lang', 'en' %}{% for post in posts limit: 20 %}<entry><title>{{ post.title | xml_escape }}</title><link href="{{ post.url | absolute_url }}"/><id>{{ post.url | absolute_url }}</id><published>{{ post.date | date_to_xmlschema }}</published><updated>{{ post.date | date_to_xmlschema }}</updated><summary>{{ post.excerpt | strip_html | xml_escape }}</summary><content type="html">{{ post.content | xml_escape }}</content></entry>{% endfor %}</feed>
