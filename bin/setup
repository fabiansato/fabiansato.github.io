#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
expected="$(cat .ruby-version)"
actual="$(ruby -e 'print RUBY_VERSION')"
if [[ "$actual" != "$expected" ]]; then
  printf 'Ruby %s required; found %s. Activate the version in .ruby-version first.\n' "$expected" "$actual" >&2
  exit 1
fi
bundle config set --local path vendor/bundle
bundle install
